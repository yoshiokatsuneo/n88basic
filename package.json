{
  "name": "n88-browser",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/*.test.js",
    "build": "npm run typecheck && tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "pretest": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/*.js\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/*.js\" eslint.config.mjs",
    "lint": "eslint src --max-warnings 0",
    "check": "npm run lint && npm run format:check && npm test",
    "package:site": "node scripts/package-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
